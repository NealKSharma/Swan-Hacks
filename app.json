{
  "expo": {
    "name": "CySense",
    "slug": "cysense",
    "scheme": "cysense",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/logos/cysense_app_icon.png",
    "splash": {
      "image": "./assets/logos/cysense_app_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.iastate.cysense",
      "associatedDomains": ["applinks:cysense.app"],
      "icon": "./assets/logos/cysense_app_icon.png",
      "infoPlist": {
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/logos/cysense_app_icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CySense uses your location to check whether you are near a campus study hotspot right now.",
          "locationAlwaysAndWhenInUsePermission": "CySense can use anonymous background location snapshots to estimate how busy campus study spaces are.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
